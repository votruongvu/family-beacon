rules_version = '2';

// Access rules for Family Beacon.
//
// The rule that matters most is the last one: everything not explicitly allowed
// above it is denied. Adding a capability means adding a narrow, tested rule —
// never widening an existing one, and never relying on the client to ask nicely.
//
// These rules are a security boundary. The application's own checks are for the
// experience only. Anything that decides who may see a family's locations, or
// who may resolve an assistance request, is decided here and in trusted backend
// code, on every request.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helpers -----------------------------------------------------------
    //
    // Kept small and named after the question they answer, so a rule below
    // reads as a sentence rather than as an expression to decode.

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Rules -------------------------------------------------------------
    //
    // Product capabilities add their collections here as Requirements are
    // implemented. Each arrives with rules tests that prove both the access it
    // intends to allow and the access it must refuse.

    // The Foundation's proof slice. Not a product capability: it exists so the
    // baseline can demonstrate a request reaching the datastore and coming back.
    //
    // Scoped as narrowly as anything here ever should be. The document is named
    // after its owner, so "may I touch this?" and "is this mine?" are the same
    // question, and there is no path by which one person reaches another's.
    match /diagnostics/{userId} {
      allow read, write: if isSelf(userId);
    }

    // --- Default deny ------------------------------------------------------
    //
    // Every path not matched above lands here. This is deliberately the last
    // and broadest rule: a collection nobody has written a rule for is
    // unreachable rather than open, so forgetting to secure something fails
    // closed.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
